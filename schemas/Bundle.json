{
  "$defs": {
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "company",
            "investor",
            "person",
            "product",
            "funding_event",
            "acquisition_event",
            "partnership_event",
            "category",
            "date",
            "year",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "array"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "resolution_status": {
          "default": "unresolved",
          "enum": [
            "resolved",
            "unresolved",
            "conflict"
          ],
          "title": "Resolution Status",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "name",
        "kind"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "span_start": {
          "minimum": 0,
          "title": "Span Start",
          "type": "integer"
        },
        "span_end": {
          "exclusiveMinimum": 0,
          "title": "Span End",
          "type": "integer"
        },
        "span_text": {
          "minLength": 1,
          "title": "Span Text",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "support_status": {
          "default": "unknown",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ],
          "title": "Support Status",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "span_start",
        "span_end",
        "span_text",
        "claim_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "object_id_or_value": {
          "title": "Object Id Or Value",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Id"
        },
        "valid_time": {
          "$ref": "#/$defs/ValidTime"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "resolution_status": {
          "default": "unresolved",
          "enum": [
            "resolved",
            "unresolved",
            "conflict"
          ],
          "title": "Resolution Status",
          "type": "string"
        },
        "polarity": {
          "default": "positive",
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "subject_id",
        "predicate",
        "object_id_or_value",
        "event_id",
        "valid_time",
        "evidence_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "ValidTime": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "kind": {
          "default": "state",
          "enum": [
            "event",
            "state"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "start"
      ],
      "title": "ValidTime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "entities",
    "facts",
    "evidence"
  ],
  "title": "Bundle",
  "type": "object"
}
