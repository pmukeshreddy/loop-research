{
  "$defs": {
    "Atom": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Object"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "title": "Atom",
      "type": "object"
    },
    "PublicTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "question": {
          "minLength": 10,
          "title": "Question",
          "type": "string"
        },
        "answer_schema": {
          "default": "entity_names",
          "title": "Answer Schema",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "corpus_id": {
          "title": "Corpus Id",
          "type": "string"
        },
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "data_mode": {
          "enum": [
            "fixture",
            "live"
          ],
          "title": "Data Mode",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "question",
        "as_of",
        "scope",
        "corpus_id",
        "allowed_tools",
        "data_mode"
      ],
      "title": "PublicTask",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "default": "?company",
          "title": "Target",
          "type": "string"
        },
        "answer_type": {
          "default": "company",
          "enum": [
            "company",
            "investor",
            "person",
            "product",
            "funding_event",
            "acquisition_event",
            "category",
            "date",
            "year",
            "location"
          ],
          "title": "Answer Type",
          "type": "string"
        },
        "branches": {
          "items": {
            "items": {
              "$ref": "#/$defs/Atom"
            },
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Branches",
          "type": "array"
        }
      },
      "required": [
        "branches"
      ],
      "title": "Query",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "identified_target",
          "enum": [
            "corpus_bounded",
            "identified_target"
          ],
          "title": "Mode",
          "type": "string"
        },
        "candidate_universe": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Universe"
        },
        "expected_count": {
          "default": 1,
          "minimum": 1,
          "title": "Expected Count",
          "type": "integer"
        },
        "allow_retrospective": {
          "default": false,
          "title": "Allow Retrospective",
          "type": "boolean"
        },
        "description": {
          "default": "Identify the specified target; no open-web completeness claim.",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task": {
      "$ref": "#/$defs/PublicTask"
    },
    "query": {
      "$ref": "#/$defs/Query"
    },
    "answer": {
      "items": {
        "type": "string"
      },
      "title": "Answer",
      "type": "array"
    },
    "seed_id": {
      "title": "Seed Id",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Id"
    },
    "layer": {
      "default": 0,
      "title": "Layer",
      "type": "integer"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    },
    "expanded_leaf": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expanded Leaf"
    },
    "intermediate_answer": {
      "items": {
        "type": "string"
      },
      "title": "Intermediate Answer",
      "type": "array"
    },
    "subquery": {
      "anyOf": [
        {
          "$ref": "#/$defs/Query"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "added_atoms": {
      "items": {
        "$ref": "#/$defs/Atom"
      },
      "title": "Added Atoms",
      "type": "array"
    },
    "candidate_decisions": {
      "additionalProperties": true,
      "title": "Candidate Decisions",
      "type": "object"
    },
    "cell_evidence": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Cell Evidence",
      "type": "object"
    },
    "graph_id": {
      "default": "",
      "title": "Graph Id",
      "type": "string"
    }
  },
  "required": [
    "task",
    "query",
    "answer",
    "seed_id",
    "parent_id"
  ],
  "title": "Candidate",
  "type": "object"
}
