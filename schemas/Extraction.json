{
  "$defs": {
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "company",
            "investor",
            "person",
            "product",
            "funding_event",
            "acquisition_event",
            "category",
            "date",
            "year",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "array"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "resolution_status": {
          "default": "unresolved",
          "enum": [
            "resolved",
            "unresolved",
            "conflict"
          ],
          "title": "Resolution Status",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "name",
        "kind"
      ],
      "title": "Entity",
      "type": "object"
    },
    "ExtractedFact": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "object_id_or_value": {
          "title": "Object Id Or Value",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Id"
        },
        "valid_time": {
          "$ref": "#/$defs/ValidTime"
        },
        "resolution_status": {
          "enum": [
            "resolved",
            "unresolved",
            "conflict"
          ],
          "title": "Resolution Status",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "title": "Quotes",
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "object_id_or_value",
        "event_id",
        "valid_time",
        "resolution_status",
        "polarity",
        "quotes"
      ],
      "title": "ExtractedFact",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        }
      },
      "required": [
        "source_id",
        "quote",
        "start"
      ],
      "title": "Quote",
      "type": "object"
    },
    "ValidTime": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "kind": {
          "default": "state",
          "enum": [
            "event",
            "state"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "start"
      ],
      "title": "ValidTime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ExtractedFact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "required": [
    "entities",
    "facts"
  ],
  "title": "Extraction",
  "type": "object"
}
