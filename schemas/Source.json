{
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "url_or_local_origin": {
      "title": "Url Or Local Origin",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Published At"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "raw_hash": {
      "title": "Raw Hash",
      "type": "string"
    },
    "text_path": {
      "title": "Text Path",
      "type": "string"
    },
    "raw_path": {
      "title": "Raw Path",
      "type": "string"
    },
    "category": {
      "default": "primary",
      "enum": [
        "primary",
        "secondary",
        "fixture"
      ],
      "title": "Category",
      "type": "string"
    },
    "redistributable": {
      "default": false,
      "title": "Redistributable",
      "type": "boolean"
    },
    "date_basis": {
      "default": "unknown",
      "title": "Date Basis",
      "type": "string"
    },
    "date_status": {
      "default": "legacy",
      "title": "Date Status",
      "type": "string"
    },
    "date_evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Date Evidence",
      "type": "array"
    },
    "original_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Url"
    },
    "final_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Url"
    },
    "redirect_chain": {
      "items": {
        "type": "string"
      },
      "title": "Redirect Chain",
      "type": "array"
    },
    "content_type": {
      "default": "",
      "title": "Content Type",
      "type": "string"
    },
    "extraction_version": {
      "default": "legacy",
      "title": "Extraction Version",
      "type": "string"
    },
    "outbound_links": {
      "items": {
        "type": "string"
      },
      "title": "Outbound Links",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "url_or_local_origin",
    "title",
    "published_at",
    "retrieved_at",
    "content_hash",
    "raw_hash",
    "text_path",
    "raw_path"
  ],
  "title": "Source",
  "type": "object"
}
